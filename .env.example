# Database
POSTGRES_URL=postgresql+asyncpg://webhookforge:webhookforge@postgres:5432/webhookforge

# Redis
REDIS_URL=redis://redis:6379/0

# API authentication
API_KEY=your-api-key-here

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Delivery settings
# Four retries plus the initial attempt equals five total attempts.
MAX_DELIVERY_RETRIES=4
DELIVERY_TIMEOUT_SECONDS=5
MAX_PAYLOAD_SIZE_BYTES=65536

# Rate limiting
RATE_LIMIT_EVENTS_PER_MINUTE=100
